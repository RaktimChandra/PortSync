    {
      "id": 9,
      "type": "timeseries",
      "title": "Processing latency",
      "description": "Processing = validate + apply + commit. End-to-end = Kafka record timestamp to commit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(portsync_event_processing_seconds_bucket[1m])))",
          "legendFormat": "processing p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(portsync_event_processing_seconds_bucket[1m])))",
          "legendFormat": "processing p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(portsync_event_latency_seconds_bucket[1m])))",
          "legendFormat": "end-to-end p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
